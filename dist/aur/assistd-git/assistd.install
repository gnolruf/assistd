post_install() {
  cat <<'EOF'

==> Initialize your user config:
      assistd init-config
    (writes the annotated sample to ~/.config/assistd/config.toml;
    a copy is also installed at /etc/assistd/config.toml)

==> Install llama.cpp for the LLM backend (provides llama-server):
      pacman -S llama.cpp        # or build llama.cpp-* from the AUR

==> Enable and start the user service:
      systemctl --user enable --now assistd

==> GPU speech-to-text (NVIDIA, optional):
      Rebuild from source against sherpa-onnx's CUDA libraries; see the
      README. Requires the 'cuda' and 'cudnn' packages.

EOF
}

post_upgrade() {
  post_install
}
