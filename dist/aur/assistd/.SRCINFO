pkgbase = assistd
	pkgdesc = A local-model agent daemon for Linux (LLM + voice + tools + WM integration)
	pkgver = 1.4.0
	pkgrel = 1
	url = https://github.com/gnolruf/assistd
	install = assistd.install
	arch = x86_64
	license = Apache-2.0
	makedepends = rust
	makedepends = cmake
	makedepends = clang
	makedepends = pkgconf
	makedepends = git
	depends = alsa-lib
	depends = dbus
	optdepends = llama.cpp: provides llama-server (required to run a local LLM backend)
	optdepends = espeak-ng: phonemizer for Piper (vits) text-to-speech voices
	optdepends = searxng-git: provides searxng-run for the web search command
	optdepends = maim: X11 full/region screenshot capture
	optdepends = slop: maim --select region picker
	optdepends = grim: Wayland full/region screenshot capture
	optdepends = xdotool: X11 focused-window screenshot
	optdepends = xorg-xrandr: X11 multi-monitor info for screenshots
	optdepends = sway: Wayland focused-window screenshot via swaymsg
	optdepends = hyprland: Wayland focused-window screenshot via hyprctl
	optdepends = bubblewrap: sandboxed bash command tool
	optdepends = pipewire-alsa: route audio through PipeWire (otherwise raw ALSA)
	optdepends = notification-daemon: desktop notifications from the tray
	options = !lto
	backup = etc/assistd/config.toml
	source = assistd-1.4.0.tar.gz::https://github.com/gnolruf/assistd/archive/refs/tags/v1.4.0.tar.gz
	sha256sums = SKIP

pkgname = assistd
